{
  "name": "sohbet",
  "version": "1.0.0",
  "private": true,
  "description": "Sohbet - cevrimdisi sosyal uygulama",
  "main": "electron-main.js",
  "scripts": {
    "start": "electron .",
    "web": "node server.js",
    "dev": "node --watch server.js",
    "dist": "electron-builder --win portable"
  },
  "build": {
    "appId": "com.sohbet.app",
    "productName": "Sohbet",
    "files": [
      "electron-main.js",
      "public/**",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "artifactName": "Sohbet.exe",
      "icon": "public/icon-512.png"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "express": "^5.3.0",
    "multer": "^2.5.0",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "localtunnel": "^2.0.2",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.5"
  }
}
